# ==============================================================================
# SharePlate - Root Environment Variables Reference
# Hacktober HackDays 2026 | SheBuilds Delhi Chapter | Powered by MLH
# ==============================================================================
# Copy this file to individual .env files in apps/web and apps/api.
# DO NOT COMMIT ACTUAL SECRETS TO VERSION CONTROL!

# ------------------------------------------------------------------------------
# Frontend Variables (apps/web/.env)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_API_BASE_URL=http://localhost:5000/api
# Enable browser-local demo mode (Supabase and Express are not deployed for the static demo)
VITE_DEMO_MODE=true
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
VITE_NOTION_URL=

# ------------------------------------------------------------------------------
# Backend Variables (apps/api/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Supabase Server Config
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY is optional for dev, required only for admin elevated operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Cloudinary Mandatory Server Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=shareplate/donations
CLOUDINARY_MAX_FILE_SIZE_MB=5
