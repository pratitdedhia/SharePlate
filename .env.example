# ==============================================================================
# SharePlate - Root Environment Variables Reference
# Hacktober HackDays 2026 | SheBuilds Delhi Chapter | Powered by MLH
# ==============================================================================
# Copy this file to individual .env files in apps/web and apps/api.
# DO NOT COMMIT ACTUAL SECRETS TO VERSION CONTROL!

# ------------------------------------------------------------------------------
# Frontend Variables (apps/web/.env)
# ------------------------------------------------------------------------------
# Firebase Cloud Firestore & Auth Configuration
VITE_FIREBASE_API_KEY=AIzaSyCcWlUFJKndQyDVUSPpLLMmaWwomHowP_k
VITE_FIREBASE_AUTH_DOMAIN=shareplate-57783.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=shareplate-57783
VITE_FIREBASE_STORAGE_BUCKET=shareplate-57783.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1075617712212
VITE_FIREBASE_APP_ID=1:1075617712212:web:ab667a7e6b1c3652ec45c1
VITE_FIREBASE_MEASUREMENT_ID=G-945TEWG4F3

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_API_BASE_URL=http://localhost:5000/api

# Enable demo mode (uses browser-local demoStore when backend/Supabase is offline)
VITE_DEMO_MODE=true

# Cloudinary Mandatory Public Cloud Name (Client safe)
# Create a free account at https://cloudinary.com and copy your Cloud Name from the dashboard:
VITE_CLOUDINARY_CLOUD_NAME=<<FILL: your-cloudinary-cloud-name>>

# Cloudinary Unsigned Upload Preset (Enables direct client uploads without exposing secrets)
# Settings > Upload > Upload Presets > Add upload preset > Signing Mode: Unsigned > Folder: shareplate/donations
VITE_CLOUDINARY_UPLOAD_PRESET=<<FILL: your-unsigned-upload-preset>>

# Optional Cloudinary flags (free-tier safe guards)
VITE_CLOUDINARY_AUTO_TAG=false
VITE_CLOUDINARY_MODERATION=false
VITE_CLOUDINARY_ENHANCE=false

# Public Notion Page Link
VITE_NOTION_URL=https://app.notion.com/p/SharePlate-Hacktober-HackDays-2026-Report-40471fac0e5c813cb0d3de560f29a8aa?source=copy_link

# ------------------------------------------------------------------------------
# Backend Variables (apps/api/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Supabase Server Config
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY is optional for dev, required only for admin elevated operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Allow demo user auth bypass outside production (ignored in production)
ALLOW_DEMO_AUTH=false

# Cloudinary Server Configuration (Secret API Key & Secret remain backend-only)
CLOUDINARY_CLOUD_NAME=<<FILL: your-cloudinary-cloud-name>>
CLOUDINARY_API_KEY=<<FILL: your-cloudinary-api-key>>
CLOUDINARY_API_SECRET=<<FILL: your-cloudinary-api-secret>>
CLOUDINARY_FOLDER=shareplate/donations
CLOUDINARY_MAX_FILE_SIZE_MB=5
