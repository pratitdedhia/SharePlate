# Cloudinary Frontend Configuration (Safe for client-side uploads)
# 1. Sign up / log in to Cloudinary (free tier) and find your Cloud Name on the dashboard.
# 2. Go to Settings > Upload > Upload Presets and create an UNSIGNED preset (Signing Mode: Unsigned).
# 3. Set the target folder to `shareplate/donations`.
# 4. Paste your Cloud Name and Upload Preset below.
# (Never add API Secret or private credentials to frontend code or frontend .env)
VITE_CLOUDINARY_CLOUD_NAME=<<FILL: your-cloudinary-cloud-name>>
VITE_CLOUDINARY_UPLOAD_PRESET=<<FILL: your-unsigned-upload-preset>>

# Optional Cloudinary Features (guard against free plan limitations)
VITE_CLOUDINARY_AUTO_TAG=false
VITE_CLOUDINARY_MODERATION=false
VITE_CLOUDINARY_ENHANCE=false

# Project Journey Documentation (Public Notion Page URL)
VITE_NOTION_URL=<<FILL: https://your-notion-page-url>>

# Demo Evaluation Mode (enables browser-local data storage when Supabase/API is offline)
VITE_DEMO_MODE=true
